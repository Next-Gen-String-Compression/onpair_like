# Every external revision this repository builds against, one KEY=value per line.
# Shell scripts source it, the candidates' CMake reads it through candidates/common/pins.cmake,
# Python parses the lines.

# DuckDB: our fork with the compressed contains in third_party/duckdb, built for both DuckDB arms of
# e2e/, which differ only in enable_fsst_contains. The folder has no .git, so its version string
# comes from here, with DuckDB's own placeholder for an unknown commit hash.
DUCKDB_DESCRIBE=v1.5.4-10016-g0123456789

# Vortex: the DuckDB extension, built twice against two vortex-duckdb revisions (e2e/).
DUCKDB_VORTEX_URL=https://github.com/vortex-data/duckdb-vortex
DUCKDB_VORTEX_SHA=3c3eacc368c96531c3237d4f7ef444a011667d87
# its duckdb submodule
DUCKDB_VORTEX_DESCRIBE=v1.5.5-0-gd8cdaa33fda
# 0.86.1, the revision duckdb-vortex's Cargo.toml commits. Its two builds take vortex-duckdb from
# third_party/vortex-0.86.1 (that revision) and third_party/vortex-onpair (38378fa of an upstream
# OnPair branch, OnPair strings), each plus a per-file segment cache behind
# VORTEX_SEGMENT_CACHE_MB.
VORTEX_UPSTREAM_REV=d1fe2dc46d2b947a2304122d0d0423332fcb77a3

# cwida/fsst upstream: the fsst candidate
CWIDA_FSST_SHA=e638d4cf8c26129d73c242a4127b42b975de5b63

# TUM's FSST-LIKE matching: the fsst_like_tum candidate
TUM_FSST_SHA=1755328b61f4e48ab7f53b315bbb20e8130059f2
TUM_FSST_LIKE_SHA=b1eb3ab9c63ea0199a381b92371a3154190b4406
FMT_TAG=12.1.0

