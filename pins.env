# Every external revision this repository builds against, one KEY=value per line.
# Shell scripts source it, the candidates' CMake reads it through candidates/common/pins.cmake,
# Python parses the lines. A git rev in a Cargo.toml has to be a literal, so those stay in their
# Cargo.toml and harness/tests/pins.rs checks them against the *_REV keys here.

# DuckDB: the fork with the compressed contains, used for both DuckDB arms of e2e/; the arms differ
# only in enable_fsst_contains. Its fsst submodule must be FSST_SHA, which e2e/build.sh checks.
DUCKDB_URL=https://github.com/gropaul/duckdb
DUCKDB_SHA=27e50719866e2b46e758c35b89f632a0c1bbd0cf
# `git describe --tags --long` of the pin: a shallow clone has no tags to derive the version from
DUCKDB_DESCRIBE=v1.5.4-10013-g27e50719866

# gropaul/fsst, branch search/prefilter-simple: whole-string compression, codes in byte order of their
# symbols, code counts, and the prefilter under search/. The fsst_prefilter candidates, the paper's
# plan-log and kernel scripts, the graph-viz fixtures, and DuckDB's fsst submodule.
FSST_URL=https://github.com/gropaul/fsst
FSST_SHA=bdaab1dbe375e28d0f46c43a488325d37f4d797e

# Vortex: the DuckDB extension, built twice against two vortex-duckdb revisions (e2e/).
DUCKDB_VORTEX_URL=https://github.com/vortex-data/duckdb-vortex
DUCKDB_VORTEX_SHA=3c3eacc368c96531c3237d4f7ef444a011667d87
# its duckdb submodule
DUCKDB_VORTEX_DESCRIBE=v1.5.5-0-gd8cdaa33fda
# 0.86.1, the revision duckdb-vortex's Cargo.toml commits
VORTEX_UPSTREAM_REV=d1fe2dc46d2b947a2304122d0d0423332fcb77a3
# Both builds take vortex-duckdb from the fork, each revision plus a per-file
# segment cache behind VORTEX_SEGMENT_CACHE_MB.
VORTEX_URL=https://github.com/gropaul/vortex.git
# e2e/0.86.1-segment-cache, on d1fe2dc
VORTEX_BASE_REV=8311cc294a66acd58d4e49a0eae9b2da7758cb32
# e2e/onpair-segment-cache, on 38378fa of ji/onpair-prefilter-dispatch-better-chunk, OnPair strings
VORTEX_ONPAIR_REV=9019a433331712714a80a109a19f29ef42e4a3a0

# cwida/fsst upstream: the fsst and fsst_decode_prefilter candidates
CWIDA_FSST_SHA=e638d4cf8c26129d73c242a4127b42b975de5b63

# TUM's FSST-LIKE matching: the fsst_like_tum and dict_fsst_like_tum candidates, and the provenance
# datasets/fsst-like-tum/make_suites.py records
TUM_FSST_SHA=1755328b61f4e48ab7f53b315bbb20e8130059f2
TUM_FSST_LIKE_SHA=b1eb3ab9c63ea0199a381b92371a3154190b4406
FMT_TAG=12.1.0

# gropaul/onpair, branch feat/prune-factor-superset: the sibling checkout ../onpair that onpair_spiral,
# fsst_rs and paper/gen-kernel.sh build by path; gen-kernel.sh refuses a checkout not clean at it.
ONPAIR_URL=https://github.com/gropaul/onpair
ONPAIR_SHA=df8eb1051adaf330ed273ce57b16cc363d852233

# OnPair: the C++ reference for the onpair candidate, and the spiraldb crate the onpair_spiral_*
# variants pin in their Cargo.toml
ONPAIR_CPP_SHA=f8ecc64fa7786cfa6fc46d46564135ee99a8ba49
ONPAIR_SPIRAL_PINNED_REV=5927cce985a6e86bc6f49f4ae24106e1fc085e80
ONPAIR_SPIRAL_REFACTOR_REV=78f53c696475eb2c67ad1c3737791a714feb06c8
ONPAIR_SPIRAL_SUBSTRING_REV=940f77cdd8b140a2e004a1fddb347aa926e02dac
