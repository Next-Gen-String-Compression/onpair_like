/* Embeds the vendored openai100kpatched token table into .rodata.
 * Upstream (token-vldb2026) embeds these .bin files with C++26 `#embed`,
 * which needs GCC 15+/Clang 19+; `.incbin` is the toolchain-portable
 * equivalent on GNU as. Configured by each candidate's CMake (absolute
 * paths + a candidate-specific symbol prefix, so the llm_token candidates
 * stay independently linkable into one harness binary). */
    .section .rodata
    .balign 64
    .globl @LB_TOKEN_PREFIX@_dict
@LB_TOKEN_PREFIX@_dict:
    .incbin "@LB_TOKEN_DIR@/openai100kpatched_dict.bin"
    .balign 64
    .globl @LB_TOKEN_PREFIX@_lengths
@LB_TOKEN_PREFIX@_lengths:
    .incbin "@LB_TOKEN_DIR@/openai100kpatched_lengths.bin"
    .section .note.GNU-stack,"",@progbits
